@model IEnumerable<Contract_Monthly_Claim_System.Models.Claim>
<style>
    /* HR Dashboard Specific Styles */
    .hr-dashboard-welcome {
        background: white;
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        border-left: 5px solid #9b59b6;
    }

        .hr-dashboard-welcome h1 {
            color: #2c3e50;
            margin-bottom: 10px;
            font-size: 2.2rem;
        }

        .hr-dashboard-welcome p {
            color: #7f8c8d;
            font-size: 1.1rem;
        }

        .hr-dashboard-welcome i {
            color: #9b59b6;
            margin-right: 15px;
        }

    /* HR Specific Stat Cards */
    .stat-card.hr-total {
        border-color: #9b59b6;
    }

        .stat-card.hr-total i {
            color: #9b59b6;
        }

        .stat-card.hr-total h3 {
            color: #9b59b6;
        }

    .stat-card.hr-payroll {
        border-color: #e67e22;
    }

        .stat-card.hr-payroll i {
            color: #e67e22;
        }

        .stat-card.hr-payroll h3 {
            color: #e67e22;
        }

    .stat-card.hr-lecturers {
        border-color: #3498db;
    }

        .stat-card.hr-lecturers i {
            color: #3498db;
        }

        .stat-card.hr-lecturers h3 {
            color: #3498db;
        }

    .stat-card.hr-budget {
        border-color: #e74c3c;
    }

        .stat-card.hr-budget i {
            color: #e74c3c;
        }

        .stat-card.hr-budget h3 {
            color: #e74c3c;
        }

    /* HR Quick Actions */
    .hr-actions {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .hr-action-card {
        background: white;
        border-radius: 12px;
        padding: 25px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
        border-top: 4px solid #9b59b6;
        cursor: pointer;
    }

        .hr-action-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

        .hr-action-card i {
            font-size: 2.2rem;
            color: #9b59b6;
            margin-bottom: 15px;
        }

        .hr-action-card h4 {
            color: #2c3e50;
            margin-bottom: 10px;
            font-size: 1.1rem;
        }

        .hr-action-card p {
            color: #7f8c8d;
            font-size: 0.9rem;
        }

    /* HR Sections */
    .hr-section {
        background: white;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    }

    .section-header {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
        border-bottom: 2px solid #ecf0f1;
        padding-bottom: 15px;
    }

        .section-header h2 {
            color: #2c3e50;
            font-size: 1.5rem;
            margin: 0;
        }

        .section-header i {
            color: #9b59b6;
            margin-right: 12px;
            font-size: 1.2rem;
        }

    /* Lecturer List */
    .lecturer-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
    }

    .lecturer-card {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 20px;
        border-left: 4px solid #3498db;
        transition: all 0.3s ease;
    }

        .lecturer-card:hover {
            transform: translateX(5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .lecturer-card h4 {
            color: #2c3e50;
            margin-bottom: 8px;
            font-size: 1.1rem;
        }

        .lecturer-card p {
            color: #7f8c8d;
            margin-bottom: 5px;
            font-size: 0.9rem;
        }

        .lecturer-card .contract-type {
            display: inline-block;
            background: #3498db;
            color: white;
            padding: 4px 12px;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: 600;
        }

    /* Report Generation */
    .report-form {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        margin-top: 15px;
    }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            color: #2c3e50;
        }

        .form-group select,
        .form-group input {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 0.9rem;
        }

    .btn-hr-primary {
        background: linear-gradient(135deg, #9b59b6, #8e44ad);
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        width: 100%;
    }

        .btn-hr-primary:hover {
            background: linear-gradient(135deg, #8e44ad, #9b59b6);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(155, 89, 182, 0.3);
        }

    /* Payment Processing */
    .payment-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 15px;
    }

    .btn-process {
        background: linear-gradient(135deg, #27ae60, #229954);
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-process:hover {
            background: linear-gradient(135deg, #229954, #27ae60);
            transform: translateY(-2px);
        }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .hr-actions {
            grid-template-columns: 1fr;
        }

        .lecturer-list {
            grid-template-columns: 1fr;
        }

        .hr-dashboard-welcome h1 {
            font-size: 1.8rem;
        }
    }
</style>

<div class="container">
    <!-- Role Switcher -->
    <div class="role-switcher" style="margin-bottom: 16px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
        <label for="roleSwitch" style="margin:0; font-weight:600;"><i class="fas fa-user-tag"></i> Switch View:</label>
        <select id="roleSwitch" class="form-control" style="max-width: 260px;"
                data-mgr="@Url.Action("ManagerDashboard", "Home")"
                data-coo="@Url.Action("CoordinatorDashboard", "Home")"
                data-lec="@Url.Action("LectureDashboard", "Home")"
                data-hr="@Url.Action("HRDashboard", "Home")"
                onchange="switchRole(this)">
            <option value="manager">Manager</option>
            <option value="coordinator">Program Coordinator</option>
            <option value="lecturer">Lecturer</option>
            <option value="hr" selected>HR Department</option>
        </select>
        <div class="btn-group" role="group" aria-label="Switch View Links">
            <a href="@Url.Action("ManagerDashboard", "Home")" class="btn btn-sm btn-outline-secondary">Manager</a>
            <a href="@Url.Action("CoordinatorDashboard", "Home")" class="btn btn-sm btn-outline-secondary">Coordinator</a>
            <a href="@Url.Action("LectureDashboard", "Home")" class="btn btn-sm btn-outline-secondary">Lecturer</a>
            <a href="@Url.Action("HRDashboard", "Home")" class="btn btn-sm btn-outline-primary">HR</a>
        </div>
    </div>

    <div id="hrView" class="role-view">
        <!-- HR Dashboard Welcome -->
        <div class="hr-dashboard-welcome">
            <h1><i class="fas fa-users-cog"></i> HR Department Dashboard</h1>
            <p>Welcome, @ViewBag.FullName! Manage payroll, lecturers, and system administration.</p>
        </div>

        <!-- HR Overview Stats -->
        <div class="overview-stats">
            <div class="stat-card hr-total">
                <i class="fas fa-file-invoice-dollar"></i>
                <h3>@Model.Count(c => c.Status == "Approved")</h3>
                <p>Approved Claims</p>
            </div>

            <div class="stat-card hr-payroll">
                <i class="fas fa-money-check"></i>
                <h3>@String.Format("R {0:N0}", Model.Where(c => c.Status == "Approved").Sum(c => c.Total))</h3>
                <p>Total Payroll</p>
            </div>

            <div class="stat-card hr-lecturers">
                <i class="fas fa-chalkboard-teacher"></i>
                <h3>42</h3>
                <p>Active Lecturers</p>
            </div>

            <div class="stat-card hr-budget">
                <i class="fas fa-chart-pie"></i>
                <h3>@String.Format("R {0:N0}", Model.Where(c => c.Status == "Approved").Sum(c => (decimal)c.Total) * 1.2m)</h3>
                <p>Monthly Budget</p>
            </div>
        </div>

        <!-- HR Quick Actions -->
        <div class="hr-actions">
            <div class="hr-action-card" onclick="generatePayrollReport()">
                <i class="fas fa-file-export"></i>
                <h4>Payroll Report</h4>
                <p>Generate monthly payroll reports</p>
            </div>

            <div class="hr-action-card" onclick="manageLecturers()">
                <i class="fas fa-user-edit"></i>
                <h4>Manage Lecturers</h4>
                <p>Add/edit lecturer information</p>
            </div>

            <div class="hr-action-card" onclick="processPayments()">
                <i class="fas fa-money-bill-wave"></i>
                <h4>Process Payments</h4>
                <p>Batch payment processing</p>
            </div>

            <div class="hr-action-card" onclick="viewAnalytics()">
                <i class="fas fa-chart-bar"></i>
                <h4>Analytics</h4>
                <p>View HR metrics and trends</p>
            </div>
        </div>

        <div class="row">
            <!-- Left Column -->
            <div class="col-lg-8">
                <!-- Approved Claims for Payment -->
                <div class="hr-section">
                    <div class="section-header">
                        <h2><i class="fas fa-check-circle"></i> Approved Claims Ready for Payment</h2>
                    </div>
                    <div class="table-responsive">
                        <table class="claims-table">
                            <thead>
                                <tr>
                                    <th>Claim ID</th>
                                    <th>Lecturer</th>
                                    <th>Amount</th>
                                    <th>Approved Date</th>
                                    <th>Payment Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Model.Where(c => c.Status == "Approved").Take(5))
                                {
                                    <tr>
                                        <td>@claim.Id</td>
                                        <td>@claim.LecturerName</td>
                                        <td class="fw-bold text-success">R @claim.Total.ToString("N2")</td>
                                        <td>@DateTime.Now.AddDays(-new Random().Next(1, 7)).ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <span class="status-badge status-pending">Pending Payment</span>
                                        </td>
                                        <td>
                                            <div class="payment-actions">
                                                <button class="btn-process" onclick="processSinglePayment(@claim.Id)">
                                                    <i class="fas fa-check"></i> Pay
                                                </button>
                                                <button class="btn-view" onclick="viewClaim(@claim.Id)">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="text-end mt-3">
                        <button class="btn-hr-primary" onclick="processBatchPayments()">
                            <i class="fas fa-bolt"></i> Process All Payments
                        </button>
                    </div>
                </div>

                <!-- Monthly Reports -->
                <div class="hr-section">
                    <div class="section-header">
                        <h2><i class="fas fa-chart-bar"></i> Report Generation</h2>
                    </div>
                    <div class="report-form">
                        <div class="form-group">
                            <label for="reportType">Report Type</label>
                            <select id="reportType" class="form-control">
                                <option value="payroll">Monthly Payroll Report</option>
                                <option value="lecturer">Lecturer Performance</option>
                                <option value="department">Department Summary</option>
                                <option value="budget">Budget Analysis</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="reportPeriod">Period</label>
                            <select id="reportPeriod" class="form-control">
                                <option value="current">Current Month</option>
                                <option value="last">Last Month</option>
                                <option value="quarter">This Quarter</option>
                                <option value="year">This Year</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="reportFormat">Format</label>
                            <select id="reportFormat" class="form-control">
                                <option value="pdf">PDF</option>
                                <option value="excel">Excel</option>
                                <option value="csv">CSV</option>
                            </select>
                        </div>
                        <button class="btn-hr-primary" onclick="generateReport()">
                            <i class="fas fa-download"></i> Generate Report
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right Column -->
            <div class="col-lg-4">
                <!-- Active Lecturers -->
                <div class="hr-section">
                    <div class="section-header">
                        <h2><i class="fas fa-users"></i> Active Lecturers</h2>
                    </div>
                    <div class="lecturer-list">
                        <div class="lecturer-card">
                            <h4>Dr. Sarah Johnson</h4>
                            <p><i class="fas fa-envelope"></i> s.johnson@iie.ac.za</p>
                            <p><i class="fas fa-phone"></i> +27 11 123 4567</p>
                            <span class="contract-type">Full-time</span>
                        </div>
                        <div class="lecturer-card">
                            <h4>Prof. Mike Smith</h4>
                            <p><i class="fas fa-envelope"></i> m.smith@iie.ac.za</p>
                            <p><i class="fas fa-phone"></i> +27 11 123 4568</p>
                            <span class="contract-type">Part-time</span>
                        </div>
                        <div class="lecturer-card">
                            <h4>Dr. Emily Brown</h4>
                            <p><i class="fas fa-envelope"></i> e.brown@iie.ac.za</p>
                            <p><i class="fas fa-phone"></i> +27 11 123 4569</p>
                            <span class="contract-type">Full-time</span>
                        </div>
                    </div>
                    <div class="text-end mt-3">
                        <button class="btn-hr-primary" onclick="manageLecturers()">
                            <i class="fas fa-user-cog"></i> Manage All Lecturers
                        </button>
                    </div>
                </div>

                <!-- System Overview -->
                <div class="hr-section">
                    <div class="section-header">
                        <h2><i class="fas fa-cog"></i> System Overview</h2>
                    </div>
                    <div style="display: grid; gap: 15px;">
                        <div style="display: flex; justify-content: between; align-items: center;">
                            <span>System Uptime:</span>
                            <strong class="text-success">99.8%</strong>
                        </div>
                        <div style="display: flex; justify-content: between; align-items: center;">
                            <span>Pending Tasks:</span>
                            <strong class="text-warning">@Model.Count(c => c.Status == "Pending")</strong>
                        </div>
                        <div style="display: flex; justify-content: between; align-items: center;">
                            <span>Processed This Month:</span>
                            <strong class="text-info">@Model.Count(c => c.Status == "Approved")</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("~/Views/Shared/_Chatbot.cshtml")

<script>
    // Role switching function
    function switchRole(select) {
        const value = select.value;
        const urls = {
            'manager': select.dataset.mgr,
            'coordinator': select.dataset.coo,
            'lecturer': select.dataset.lec,
            'hr': select.dataset.hr || '/Home/HRDashboard'
        };

        if (urls[value]) {
            window.location.href = urls[value];
        }
    }

    // HR Dashboard Functions
    function generatePayrollReport() {
        showNotification('Generating payroll report...', 'info');
        setTimeout(() => {
            showNotification('Payroll report generated successfully!', 'success');
            // Simulate download
            const link = document.createElement('a');
            link.href = '#';
            link.download = 'payroll_report_' + new Date().toISOString().split('T')[0] + '.pdf';
            link.click();
        }, 2000);
    }

    function manageLecturers() {
        showNotification('Opening lecturer management panel...', 'info');
        // In real implementation, this would open a modal or navigate to lecturer management page
    }

    function processPayments() {
        showNotification('Processing batch payments...', 'info');
        setTimeout(() => {
            showNotification('All payments processed successfully!', 'success');
        }, 3000);
    }

    function viewAnalytics() {
        showNotification('Loading HR analytics dashboard...', 'info');
    }

    function processSinglePayment(claimId) {
        showNotification(`Processing payment for claim #${claimId}...`, 'info');
        setTimeout(() => {
            showNotification(`Payment for claim #${claimId} completed!`, 'success');
        }, 1500);
    }

    function processBatchPayments() {
        showNotification('Processing all pending payments...', 'info');
        setTimeout(() => {
            showNotification('Batch payment processing completed!', 'success');
        }, 2500);
    }

    function generateReport() {
        const reportType = document.getElementById('reportType').value;
        const period = document.getElementById('reportPeriod').value;
        const format = document.getElementById('reportFormat').value;

        showNotification(`Generating ${reportType} report for ${period} in ${format.toUpperCase()} format...`, 'info');

        setTimeout(() => {
            showNotification('Report generated successfully!', 'success');
            // Simulate download
            const link = document.createElement('a');
            link.href = '#';
            link.download = `${reportType}_report_${period}.${format}`;
            link.click();
        }, 3000);
    }

    function viewClaim(claimId) {
        showNotification(`Viewing claim #${claimId} details...`, 'info');
        // In real implementation, this would open a modal with claim details
    }

    // Notification function (reuse from existing code)
    function showNotification(message, type) {
        // Create notification element
        const notification = document.createElement('div');
        notification.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
        notification.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
        notification.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;

        document.body.appendChild(notification);

        // Auto remove after 3 seconds
        setTimeout(() => {
            if (notification.parentNode) {
                notification.parentNode.removeChild(notification);
            }
        }, 3000);
    }

    // Initialize HR Dashboard
    document.addEventListener('DOMContentLoaded', function() {
        console.log('HR Dashboard initialized');

        // Set HR as selected in role switcher
        const roleSwitch = document.getElementById('roleSwitch');
        if (roleSwitch) {
            roleSwitch.value = 'hr';
        }
    });
</script>