@model Contract_Monthly_Claim_System.Models.HRDashboardVM
@{
    ViewData["Title"] = "HR Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="dashboard-content">
        <div class="dashboard-welcome hr-welcome">
            <h1><i class="fas fa-user-tie"></i> HR Dashboard</h1>
            <p class="text-muted mb-0">View and manage approved claims and lecturer profiles.</p>
        </div>

        <div class="overview-stats">
            <div class="stat-card approved">
                <i class="fas fa-check-circle" aria-hidden="true"></i>
                <h3 id="total-approved-count" data-value="@Model.TotalApprovedClaims">@Model.TotalApprovedClaims</h3>
                <p>Approved Claims</p>
            </div>
            <div class="stat-card payable">
                <i class="fas fa-money-bill-wave" aria-hidden="true"></i>
                <h3 id="total-payable-amount" data-value="@Model.TotalPayableAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)">@String.Format("R {0:N2}", Model.TotalPayableAmount)</h3>
                <p>Total Payable</p>
            </div>
            <div class="stat-card pending">
                <i class="fas fa-clock" aria-hidden="true"></i>
                <h3 id="pending-payments-count" data-value="@Model.PendingPayments">@Model.PendingPayments</h3>
                <p>Pending Payments</p>
            </div>
            <div class="stat-card insights">
                <i class="fas fa-file-download" aria-hidden="true"></i>
                <div class="d-flex flex-column gap-2 align-items-center">
                    <a class="btn btn-sm btn-outline-primary w-100" href="@Url.Action("ApprovedClaimsCsv","HR")" aria-label="Download approved claims as Excel">
                        <i class="fas fa-file-excel me-1"></i> Download Excel
                    </a>
                    <a class="btn btn-sm btn-outline-secondary w-100" href="@Url.Action("ApprovedClaimsReport","HR")" target="_blank" rel="noopener" aria-label="Open approved claims printable report">
                        <i class="fas fa-print me-1"></i> Print View
                    </a>
                </div>
                <p class="text-muted mb-0">Approved Claims Report</p>
            </div>
        </div>

        <div id="hr-feedback" class="alert alert-success d-none" role="status" aria-live="polite"></div>

        <div class="row g-4 align-items-start">
            <div class="col-lg">
                <div class="pending-claims">
                    <div class="section-header">
                        <h2><i class="fas fa-list" aria-hidden="true"></i> Approved Claims</h2>
                    </div>

                    <div class="dashboard-toolbar">
                        <div class="flex-grow-1">
                            <label for="hr-claim-search" class="form-label mb-1">Quick search</label>
                            <input type="search"
                                   id="hr-claim-search"
                                   class="form-control"
                                   placeholder="Search by lecturer, claim ID, title or notes"
                                   aria-label="Search approved claims"
                                   data-claims-search="#hr-claims-body tr.claim-row"
                                   data-empty-state="#hr-search-empty" />
                        </div>
                        <p class="text-muted small mb-0">Use keywords to narrow down claims instantly.</p>
                    </div>

                    <div class="table-responsive">
                        <table class="claims-table table">
                        <thead>
                            <tr>
                                <th>Claim ID</th>
                                <th>Lecturer</th>
                                <th>Title</th>
                                <th>Date of Expense</th>
                                <th>Hours Worked</th>
                                <th>Hourly Rate (R)</th>
                                <th>Total Amount (R)</th>
                                <th>Category</th>
                                <th>Additional Notes</th>
                                <th>Documents</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="hr-claims-body">
                            @if (Model.ApprovedClaims != null && Model.ApprovedClaims.Any())
                            {
                                foreach (var claim in Model.ApprovedClaims)
                                {
                                    @await Html.PartialAsync("~/Views/Claims/_ClaimRow.cshtml", claim)
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="12" class="text-center text-muted py-4" data-empty-row="true">No approved claims yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div id="hr-search-empty" class="empty-state d-none">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <h3>No claims match your search</h3>
                    <p>Try another lecturer name, claim ID or keyword.</p>
                </div>
            </div>
            </div>
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header fw-bold text-primary">
                        <i class="fas fa-users me-2" aria-hidden="true"></i>Lecturers
                    </div>
                    <div class="card-body" style="max-height:520px;overflow:auto">
                        @if (Model.Lecturers?.Count > 0)
                        {
                            foreach (var lec in Model.Lecturers)
                            {
                                <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                                    <div>
                                        <div class="fw-bold">@lec.FullName</div>
                                        <small class="text-muted">@lec.Email</small>
                                    </div>
                                    <a class="btn btn-sm btn-outline-secondary"
                                       href="@Url.Action("LecturerProfile","HR", new { id = lec.Id })"
                                       aria-label="Open profile for @lec.FullName">
                                        <i class="fas fa-id-badge" aria-hidden="true"></i> View
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted">No lecturers found.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const totalApprovedEl = document.getElementById('total-approved-count');
    const totalPayableEl = document.getElementById('total-payable-amount');
    const pendingPaymentsEl = document.getElementById('pending-payments-count');
    const currencyFormatter = new Intl.NumberFormat('en-ZA', { style: 'currency', currency: 'ZAR', minimumFractionDigits: 2 });

    let totalApproved = parseInt(totalApprovedEl?.dataset.value ?? '0', 10) || 0;
    let pendingPayments = parseInt(pendingPaymentsEl?.dataset.value ?? '0', 10) || 0;
    let totalPayable = parseFloat(totalPayableEl?.dataset.value ?? '0') || 0;

    function refreshSummaryCards() {
        if (totalApprovedEl) {
            totalApprovedEl.dataset.value = totalApproved;
            totalApprovedEl.textContent = totalApproved;
        }
        if (pendingPaymentsEl) {
            pendingPaymentsEl.dataset.value = pendingPayments;
            pendingPaymentsEl.textContent = pendingPayments;
        }
        if (totalPayableEl) {
            const formattedAmount = currencyFormatter.format(totalPayable);
            totalPayableEl.dataset.value = totalPayable.toFixed(2);
            totalPayableEl.textContent = formattedAmount;
        }
    }

    function adjustSummary(deltaCount, deltaAmount) {
        totalApproved = Math.max(0, totalApproved + deltaCount);
        pendingPayments = Math.max(0, pendingPayments + deltaCount);
        totalPayable = Math.max(0, parseFloat((totalPayable + deltaAmount).toFixed(2)));
        refreshSummaryCards();
    }

    function parseRowAmount(row) {
        if (!row) return 0;
        const total = parseFloat(row.dataset.total ?? '0');
        return Number.isFinite(total) ? total : 0;
    }

    refreshSummaryCards();

    const hrConn = new signalR.HubConnectionBuilder().withUrl('/claimHub').build();
    hrConn.on('ReceiveClaimStatusUpdate', function (claimId, status) {
        const rowId = 'claim-row-' + claimId;
        const body = document.getElementById('hr-claims-body');
        const existing = document.getElementById(rowId);
        const statusBadge = document.getElementById('claim-status-' + claimId);

        if (status === 'Approved') {
            if (!existing && body) {
                fetch(`/Claims/Row/${claimId}`, { credentials: 'include' })
                    .then(r => r.text())
                    .then(html => {
                        const tmp = document.createElement('tbody');
                        tmp.innerHTML = html.trim();
                        const newRow = tmp.querySelector('tr');
                        if (newRow) {
                            newRow.dataset.status = 'Approved';
                            body.prepend(newRow);
                            adjustSummary(1, parseRowAmount(newRow));
                        }
                    })
                    .catch(err => console.error('HR row fetch failed', err));
            } else if (existing) {
                const wasApproved = existing.dataset.status === 'Approved';
                existing.dataset.status = 'Approved';
                if (!wasApproved) {
                    adjustSummary(1, parseRowAmount(existing));
                }
                if (statusBadge) {
                    statusBadge.textContent = status;
                    statusBadge.className = 'status-badge status-approved';
                }
            }
        } else if (existing) {
            const wasApproved = existing.dataset.status === 'Approved';
            if (wasApproved) {
                adjustSummary(-1, -parseRowAmount(existing));
            }
            if (existing.parentNode) {
                existing.parentNode.removeChild(existing);
            }
        }

        if (statusBadge && status !== 'Approved') {
            statusBadge.textContent = status;
            statusBadge.className = 'status-badge ' + (status === 'Pending' ? 'status-pending' : 'status-rejected');
        }
    });
    hrConn.start().catch(e => console.error(e));

    const feedbackAlert = document.getElementById('hr-feedback');
    const searchInput = document.getElementById('hr-claim-search');

    function showHrFeedback(type, message) {
        if (!feedbackAlert) return;
        feedbackAlert.classList.remove('d-none', 'alert-success', 'alert-danger', 'alert-warning', 'alert-info');
        const alertClass = type === 'danger' ? 'alert-danger' :
            type === 'warning' ? 'alert-warning' :
                type === 'info' ? 'alert-info' : 'alert-success';
        feedbackAlert.classList.add(alertClass);
        feedbackAlert.textContent = message;
        clearTimeout(showHrFeedback._timeoutId);
        showHrFeedback._timeoutId = setTimeout(() => feedbackAlert.classList.add('d-none'), 5000);
    }

    document.addEventListener('submit', function (evt) {
        const form = evt.target;
        if (!form.classList.contains('js-mark-paid')) {
            return;
        }
        evt.preventDefault();

        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) {
            submitBtn.disabled = true;
        }

        const formData = new FormData(form);
        fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            credentials: 'include'
        })
            .then(async response => {
                if (!response.ok) {
                    const text = await response.text();
                    throw new Error(text || 'Unable to mark as paid.');
                }
                return response.json();
            })
            .then(payload => {
                if (!payload?.success) {
                    throw new Error(payload?.message || 'Unable to mark as paid.');
                }
                showHrFeedback('success', payload.message ?? 'Claim marked as paid.');
                const row = document.getElementById('claim-row-' + payload.claimId);
                if (row) {
                    row.classList.add('table-row-fade-out');
                    adjustSummary(-1, -parseRowAmount(row));
                    setTimeout(() => {
                        row.remove();
                        if (searchInput) {
                            searchInput.dispatchEvent(new Event('input'));
                        }
                    }, 250);
                }
            })
            .catch(err => {
                console.error('MarkAsPaid error', err);
                showHrFeedback('danger', 'Could not mark claim as paid. Please try again.');
            })
            .finally(() => {
                if (submitBtn) {
                    submitBtn.disabled = false;
                }
            });
    }, true);
</script>
}
